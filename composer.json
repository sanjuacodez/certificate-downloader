{
    "name": "sjs/certificate-downloader",
    "description": "Secure WordPress Certificate Management and PDF Generation Plugin.",
    "type": "wordpress-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Sanjay Shankar",
            "email": "me@sanjayshankar.me"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.1",
        "dompdf/dompdf": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "SJS_Cert\\": "includes/"
        },
        "files": [
            "includes/helpers.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        },
        "optimize-autoloader": true,
        "sort-packages": true
    }
}